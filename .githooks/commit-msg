#!/bin/sh
# One author per commit: no Co-Authored-By or assistant attribution line (d-115f49-cad445).
# CI runs the same pattern over every commit, for clones without this hook.
if grep -qiE '^(co-authored-by|claude-session):|generated with \[?claude code' "$1"; then
  echo "commit-msg: remove the Co-Authored-By / assistant attribution line; commits have one author." >&2
  exit 1
fi
